# Reporter level: error, warn, info, http, verbose, debug, silly
PLAYWRIGHT_DEBUG_LEVEL='debug'

## Uncomment the section you need.

# Case 1, install Drupal in the test (like ci) and create a simpletest environment.
# For example from Drupal web folder: php -S http://localhost:8000
#
# DRUPAL_TEST_BASE_URL='http://localhost:8000'
# DRUPAL_TEST_SETUP_FILE='modules/custom/display_builder/tests/src/TestSite/DisplayBuilderTestSetup.php'
# DRUPAL_TEST_DB_URL=sqlite://localhost/sites/default/files/db.sqlite

# Case 2, run tests in an installed local Drupal on localhost:8000 with a
# database connected. Some modules and themes are required, @see
# tests/src/TestSite/DisplayBuilderTestSetup.php
#
# DRUPAL_TEST_BASE_URL='http://localhost:8000'
# DRUPAL_TEST_NO_INSTALL=true

# Case 3, run tests in a running installed local Drupal with DDEV.
# Some modules and themes are required, @see
# tests/src/TestSite/DisplayBuilderTestSetup.php
#
# DRUPAL_TEST_BASE_URL='https://display-builder.ddev.site'
# DRUPAL_TEST_NO_INSTALL_DDEV=true

# Some ci variables empty or ignored for local tests.
DRUPAL_WEB_ROOT=''
SIMPLETEST_URL_FOLDER=''
# DRUPAL_TEST_WEBSERVER_USER=www-data
PLAYWRIGHT_SKIP_TEARDOWN=true
