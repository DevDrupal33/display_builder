{% set test_attributes = create_attribute(test_attributes|default({})) %}
{% set test_attributes = test_attributes.addClass(['test-attr']) %}
{% set test_attributes = test_attributes.setAttribute('data-test', 'testing') %}

<div{{ attributes.addClass('db_test_complex') }}>
  <div{{ test_attributes }}>
    label: {{ label|default('none') }}, open: {{ open|default(false) ? 'true' : 'false' }}, duration: {{ duration|default(0) }}
    <div class="slot slot_1">
      Slot:1 {{ slot_1 }}
      <div class="slot sub_slot_1_1">
        Slot:1_1 {{ sub_slot_1_1 }}
      </div>
      <div class="slot sub_slot_1_2">
        Slot:1_2 {{ sub_slot_1_2 }}
      </div>
      <div class="slot sub_slot_1_3">
        Slot:1_3 {{ sub_slot_1_3 }}
      </div>
    </div>
    <div class="slot slot_2">
      Slot:2 {{ slot_2 }}
      <div class="slot sub_slot_2_1">
        Slot:2_1 {{ sub_slot_2_1 }}
        <div class="slot sub_slot_2_2">
          Slot:2_2 {{ sub_slot_2_2 }}
          <div class="slot sub_slot_2_3">
            Slot:2_3 {{ sub_slot_2_3 }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
