{
  "name": "drupal_playwright_test",
  "license": "LGPL-3.0-or-later",
  "description": "Tests e2e for Drupal. See tests/src/Playwright/tests",
  "version": "0.0.2",
  "private": true,
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git@git.drupal.org:project/display_builder.git"
  },
  "scripts": {
    "test": "npx playwright test --config playwright.local.config.ts --project firefox -g @display_builder",
    "test-min": "npx playwright test --config playwright.local.config.ts --project firefox -g @display_builder_min",
    "test-dev": "npx playwright test --config playwright.local.config.ts --project firefox -g @display_builder_dev_tools",
    "test-clean": "rm -rf playwright-report; rm -rf test-results;",
    "docker-serve-pw": "docker run --add-host=hostmachine:host-gateway --rm -it -p 3000:3000 --workdir /home/pwuser --user pwuser mcr.microsoft.com/playwright:v1.57.0-noble /bin/sh -c 'npx -y playwright@1.57.0 run-server --port 3000 --host 0.0.0.0'",
    "docker-serve-php": "php -S 0.0.0.0:8000 -t ../../../",
    "docker-test": "PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:3000/ npx playwright test --project firefox -g @display_builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.11.0",
    "dotenv": "^17.3.1",
    "winston": "^3.19.0"
  },
  "packageManager": "yarn@4.9.1"
}
