{
  "name": "drupal_playwright_test",
  "license": "LGPL-3.0-or-later",
  "description": "Tests e2e for Drupal. See tests/src/Playwright/tests",
  "version": "0.0.4",
  "private": true,
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git@git.drupal.org:project/display_builder.git"
  },
  "scripts": {
    "pw": "npx playwright test -c playwright.local.config.ts",
    "test": "npm run pw -- --project=firefox -g @base",
    "test:extra": "npm run pw -- --project=firefox -g @extra",
    "test:failed": "npm run pw -- --project=firefox --last-failed",
    "test:headed": "npm run pw -- --project=firefox --headed",
    "test:ui": "npm run pw -- --ui",
    "test:debug": "PWDEBUG=1 npm run pw -- --debug",
    "test:update": "npm run pw -- --project=firefox -u all --update-source-method overwrite",
    "test:clean": "rm -rf playwright-report test-results"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.0",
    "dotenv": "^17.3.1",
    "winston": "^3.19.0"
  },
  "packageManager": "yarn@4.9.1"
}
