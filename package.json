{
  "name": "drupal_playwright_test",
  "license": "LGPL-3.0-or-later",
  "description": "Tests e2e for Drupal. See tests/src/Playwright/tests",
  "version": "0.0.3",
  "private": true,
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git@git.drupal.org:project/display_builder.git"
  },
  "scripts": {
    "pw": "npx playwright test -c playwright.local.config.ts --project chromium",
    "test": "npm run pw -- -g @base",
    "test:failed": "npm run pw -- --last-failed",
    "test:headed": "npm run pw -- --headed",
    "test:ui": "npm run pw -- --ui",
    "test:debug": "PWDEBUG=1 npm run pw -- --debug",
    "test:update": "npm run pw -- -u all --update-source-method overwrite",
    "test:clean": "rm -rf playwright-report test-results"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.12.0",
    "dotenv": "^17.3.1",
    "winston": "^3.19.0"
  },
  "packageManager": "yarn@4.9.1"
}
