{#
/**
 * @file
 * Build Container component with Shadow DOM for CSS isolation.
 *
 * This component uses a custom element with Shadow DOM to completely
 * isolate the builder content from backend theme CSS.
 * The Shadow DOM boundary prevents any external CSS from affecting
 * the drag-and-drop interface.
 */
#}
<db-build-container class="db-build-container" {{ attributes }}>
  {{- content -}}
</db-build-container>
