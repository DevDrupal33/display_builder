{#
  The label is the state, the pulse is the event: the text says where the
  display stands right now, the one-shot animation says an action just put
  it there. A transient label (Restored, Reverted) decays to the plain
  state label on the next re-render, which is correct - it was only ever
  describing how the display got here.

  role="status" rather than an sl-tooltip or a toast: this used to be
  replaced by an innerHTML out-of-band swap on every action; now
  save_status.js mutates it in place after the client's own request
  succeeds, so a toast would still fire on every drag and bury the error
  stack it shares the screen with. The four data-label-* attributes are the
  only thing PHP hands the JS - which status applies is inferred from the
  request itself, per assets/js/request_action.js.
#}
{% set attributes = attributes.addClass('db-save-status') %}
{% set attributes = attributes.addClass('db-save-status--' ~ variant|default('saved')) %}
{% if pulse %}
  {% set attributes = attributes.addClass('db-save-status--pulse') %}
{% endif %}
{% set attributes = attributes.setAttribute('data-label-saved', label_saved) %}
{% set attributes = attributes.setAttribute('data-label-published', label_published) %}
{% set attributes = attributes.setAttribute('data-label-restored', label_restored) %}
{% set attributes = attributes.setAttribute('data-label-reverted', label_reverted) %}
<span{{ attributes.setAttribute('role', 'status') }}>
  <span class="db-save-status__dot" aria-hidden="true" title="{{ label }}"></span>
</span>
