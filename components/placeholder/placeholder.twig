{% set attributes = attributes.addClass('db-placeholder') %}
{% set attributes = attributes.addClass('db-placeholder-' ~ variant|default('button')) %}
{% set attributes = attributes.setAttribute('tabindex', 0) %}

{% if variant == 'button' %}
  {{ include('display_builder:button', {
    attributes: attributes,
    label: content,
  }, with_context: false) }}
{% elseif variant == 'list' or variant == 'region' %}
  <div{{ attributes }}>{{ content }}</div>
{% else %}
  {{ include('display_builder:card', {
    attributes: attributes,
    content: content,
    image: image,
  }, with_context: false) }}
{% endif %}
