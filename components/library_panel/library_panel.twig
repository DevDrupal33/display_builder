{% set id = id|default('db-library-panel--' ~ random()) %}
<div{{ attributes.addClass('db-library-panel') }}>

  {# Class is needed for library_panel.js search filter. #}
  {# Allow auto focus when opening dialog #}
  {# @see components/library_panel/search.js #}
  <div class="db-library-panel__wrap">
    {# label names the field for assistive tech (a placeholder cannot); it is
       visually hidden, @see search.css #}
    {# Not 'search': Shoelace reflects `type` onto the host, where a theme's
       `[type=search]` rule reaches it. @see assets/css/_reset.css #}
    {{ include('display_builder:input', {
      variant: 'text',
      label: 'Search the library'|t,
      placeholder: 'Search'|t,
      size: 'medium',
      autocomplete_off: true,
      clearable: true,
      attributes: {
        class: ['db-search-library'],
        'data-search-container-id': id,
        'data-elements-selector': '.db-placeholder',
        autofocus: true,
      },
      icon: 'search',
    }, with_context: false) }}
  </div>

  {% if tabs %}
  <div class="db-library-panel-tabs">
    {{ tabs }}
  </div>
  {% endif %}

  <div id="{{ id }}">
    {{ content }}
  </div>
</div>
