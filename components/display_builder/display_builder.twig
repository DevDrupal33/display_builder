{% set builder_id = builder_id|default('display-builder-' ~ random()) %}
{% set classes = [
    'display-builder',
    buildable_id ? 'display-builder-' ~ buildable_id : '',
  ]
%}
{% set attributes = attributes.setAttribute('id', builder_id).addClass(classes) %}

<section{{ attributes }}>
  {% set start %}
    <sl-button-group label="{{ 'Sidebar buttons'|t }}">
      {{ view_sidebar_buttons }}
    </sl-button-group>
    {{ start_buttons }}
  {% endset %}

  {{ include('display_builder:toolbar', {
      sticky: true,
      start: start,
      middle: view_main_tabs,
      end: end_buttons,
    }, with_context: false) }}

  <div class="display-builder__body">
    <aside id="db-first-drawer" class="db-sidebar db-sidebar--start db-background is-collapsed">
      <div class="db-sidebar__resize-handle"></div>
      <div class="db-sidebar__content">
        {% for island in view_sidebar %}
          <div class="db-sidebar__pane">
            {{ island }}
          </div>
        {% endfor %}
      </div>
    </aside>

    <div class="display-builder__main">
      {{ view_main }}
    </div>

    <aside id="db-second-drawer" class="db-sidebar db-sidebar--end db-background is-collapsed">
      <div class="db-sidebar__resize-handle"></div>
      <div class="db-sidebar__header">
        {# Ancestor breadcrumb, built client-side from the clicked node's own
           DOM ancestors (real trigger elements, no server round trip).
           Empty (and CSS-hidden) for a root-level node.
           @see components/display_builder/js/sidebar.js #}
        <div class="db-sidebar__path"></div>
        <div class="db-sidebar__heading">
          <span class="db-sidebar__title">{{ 'Settings'|t }}</span>
          {{ include('display_builder:icon_button', {
            icon: 'pin-angle',
            label: 'Pin sidebar open'|t,
            attributes: {id: 'db-second-drawer-pin', class: 'db-sidebar__pin'},
          }, with_context: false) }}
          {{ include('display_builder:icon_button', {
            icon: 'x-lg',
            label: 'Close'|t,
            attributes: {id: 'db-second-drawer-close', class: 'db-sidebar__close'},
          }, with_context: false) }}
        </div>
      </div>
      <div class="db-sidebar__content">
        {{ contextual_islands }}
      </div>
    </aside>
  </div>

  {{ view_floating_controls }}

  {% if menu_islands %}
    <div class="display-builder__menu">
      {{ menu_islands }}
    </div>
  {% endif %}

  {# Library preview on hover. @see components/display_builder/js/preview.js #}
  <div id="preview-{{ builder_id }}" class="db-background db-preview" role="tooltip" hidden></div>

  {# Toast stack, outside the scrolling main area so it stays pinned.
     @see \Drupal\display_builder\RenderableBuilderTrait::buildError() #}
  <div id="message-{{ builder_id }}" class="db-messages" role="status" aria-live="polite"></div>

</section>
