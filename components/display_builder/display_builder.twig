{% set builder_id = builder_id|default('db-display-builder-' ~ random()) %}
{% set attributes = attributes.setAttribute('id', builder_id).addClass('db-display-builder') %}

{% set contextual_id = builder_id ~ '-contextual' %}

<section{{ attributes }}>
  {% for island in view_sidebar %}
    {{ include('display_builder:modal', {
      id: island['#attributes']['id'] ~ '-sidebar',
      variant: 'sidebar',
      content: island,
      resizable: true,
    }, with_context: false) }}
  {% endfor %}

  {% set start %}
    <sl-button-group label="{{ 'Sidebar buttons'|t }}">
      {{ view_sidebar_buttons }}
    </sl-button-group>
  {% endset %}

  {% set end %}
    {{ buttons }}
    {{ include('display_builder:modal', {
      id: contextual_id,
      variant: 'dropdown',
      content: contextual_islands,
    }, with_context: false) }}
  {% endset %}

  {{ include('display_builder:toolbar', {
      sticky: true,
      start: start,
      middle: view_main_tabs,
      end: end,
    }, with_context: false) }}

  <div class="db-display-builder__main">
  {# <div class="db-display-builder__main" style="position: relative;"> #}
    <span id="message-{{ builder_id }}"></span>
    {{ view_main }}
    {# {{ include('display_builder:drawer', {
      content: contextual_islands,
      id: contextual_id,
      label: 'Edit element'|t,
      contained: false,
      placement: 'end',
    }, with_context: false) }} #}
  </div>

  {% if menu_islands %}
    <div class="db-display-builder__menu">
      {{ menu_islands }}
    </div>
  {% endif %}
</section>
