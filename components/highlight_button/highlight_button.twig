{% set attributes = attributes.setAttribute('id', id|default('shoelace-button-highlight-' ~ random())) %}
{% set attributes = attributes.setAttribute('data-set-highlight', true) %}
{% set attributes = keyboard ? attributes.setAttribute('data-keyboard', keyboard) : attributes %}
{% set attributes = title ? attributes.setAttribute('title', title) : attributes %}

{{ include('display_builder:button', {
  attributes: attributes,
  label: label,
  icon: icon,
  tooltip: tooltip,
}, with_context: false) }}
