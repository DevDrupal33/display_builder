{% set attributes = attributes.addClass('shoelace-button') %}
{% set attributes = (variant and variant != 'default') ? attributes.setAttribute('variant', variant) : attributes %}
{% set attributes = id ? attributes.setAttribute('id', 'button-' ~ id) : attributes %}

{% if tooltip %}
  <sl-tooltip>
    <div slot="content">{{ tooltip }}</div>
{% endif %}
<sl-button{{ attributes }}>
  {% if icon %}
    <sl-icon name="{{ icon }}"></sl-icon>
  {% endif %}
  {{ label }}
</sl-button>
{% if tooltip %}
  </sl-tooltip>
{% endif %}
