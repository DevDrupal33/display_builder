{% set attributes = variant ? attributes.addClass('db-modal--' ~ variant) : attributes %}
{% if resizable %}
  {% set attributes = attributes.addClass('db-modal--resizable') %}
{% endif %}

<dialog {{ attributes.addClass(['db-modal', 'db-background']).setAttribute('id', id) }}>
  {{ content }}
  {% if resizable %}
    <div class="db-modal--resize-handler" role="none"></div>
  {% endif %}
</dialog>
