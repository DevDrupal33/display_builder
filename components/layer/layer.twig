{% if title or children %}
  {% set modifier = children ? 'component' : 'block' %}
  <div {{ attributes.addClass('db-layer').addClass('db-layer--' ~ modifier) }}>
    <div class="db-layer__header">
      {% if title %}
        <div class="db-layer__title">{{ title }}</div>
      {% endif %}
      {% if info %}
        <div class="db-layer__info">
          {{ info }}
        </div>
      {% endif %}
    </div>
    {% if children %}
      <div class="db-layer__children">
        {{ children }}
      </div>
    {% endif %}
  </div>
{% endif %}
